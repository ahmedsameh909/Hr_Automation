<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem
        id="menu_hr_recruitment_root"
        name="Recruitment App"
        web_icon="hr_automation,static/description/icon.svg"
        sequence="30"
    />

    <menuitem
        id="menu_hr_job_requisitions"
        name="Job Requisitions"
        parent="menu_hr_recruitment_root"
        sequence="10"
    />

    <menuitem
        id="menu_hr_job_requisition_list"
        name="All Requisitions"
        parent="menu_hr_job_requisitions"
        action="action_hr_job_requisition"
        sequence="10"
    />

    <menuitem
        id="menu_hr_job_applicants_root"
        name="Job Applicants"
        parent="menu_hr_recruitment_root"
        sequence="20"
    />

    <menuitem
        id="menu_hr_job_applicant_list"
        name="All Applicants"
        parent="menu_hr_job_applicants_root"
        action="action_hr_job_applicant"
        sequence="10"
    />

    <record id="action_hr_automation_api_settings" model="ir.actions.act_window">
        <field name="name">API Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'hr_automation', 'bin_size': False}</field>
    </record>

    <menuitem
        id="menu_hr_automation_api_settings"
        name="API Settings"
        parent="menu_hr_recruitment_root"
        action="action_hr_automation_api_settings"
        groups="base.group_system"
        sequence="90"
    />

</odoo>